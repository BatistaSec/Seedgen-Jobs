# Configurações do Banco de Dados PostgreSQL
POSTGRES_USER=seedgen_user
POSTGRES_PASSWORD=seedgen_password_secure
POSTGRES_DB=seedgen_jobs

# Configurações do n8n
N8N_USER=admin
N8N_PASSWORD=admin_password_secure
GENERIC_TIMEZONE=America/Sao_Paulo

# Configurações de IA
AI_API_KEY=your_gemini_or_openai_api_key_here

# Configurações do Sistema
MIN_SCORE=70
HIGH_SCORE=85
MAX_JOBS_PER_RUN=100
MAX_AI_REQUESTS_PER_RUN=50
SCAN_INTERVAL=0 8,12,18 * * *
