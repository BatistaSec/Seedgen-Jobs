{
  "name": "02_job_analyzer",
  "nodes": [
    {
      "parameters": {},
      "id": "1",
      "name": "Start",
      "type": "n8n-nodes-base.start",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, title, description, company FROM jobs WHERE status = 'NEW' LIMIT 10;"
      },
      "id": "2",
      "name": "Get New Jobs",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        450,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "postgres_cred_id",
          "name": "Postgres local"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-goog-api-key",
              "value": "={{$env.AI_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "contents",
              "value": "={ \"parts\": [ { \"text\": \"Você é um assistente... Analise esta vaga para o candidato João Batista. Retorne JSON estritamente. Vaga: {{ $json.description }}\" } ] }"
            }
          ]
        },
        "options": {}
      },
      "id": "3",
      "name": "Ask Gemini AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO job_analysis (job_id, overall_score, explanation) VALUES ({{ $json.job_id }}, {{ $json.overall_score }}, '{{ $json.reason }}'); UPDATE jobs SET status = 'ANALYZED' WHERE id = {{ $json.job_id }};"
      },
      "id": "4",
      "name": "Save Analysis",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        850,
        300
      ]
    }
  ],
  "pinData": {},
  "connections": {
    "Start": {
      "main": [
        [
          {
            "node": "Get New Jobs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get New Jobs": {
      "main": [
        [
          {
            "node": "Ask Gemini AI",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ask Gemini AI": {
      "main": [
        [
          {
            "node": "Save Analysis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "v1"
}
